{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Narrow permissions for the trusted bundled application window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-capabilities",
    "allow-pick-inputs",
    "allow-convert-input",
    "allow-export-result"
  ]
}
